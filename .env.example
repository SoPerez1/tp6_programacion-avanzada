# ---------------------------------------------------------------------------
# Variables reconocidas por las apps cuando se ejecutan desde el host.
#
# Docker Compose ya define todo lo necesario; este archivo es una referencia
# para correr los procesos con npm/tsx. Los defaults de cada config.ts ya
# apuntan a localhost, así que solo hace falta exportar lo que se quiera
# cambiar (por ejemplo, en PowerShell: $env:KAFKA_BROKERS = "...").
#
# Cada servicio lee su base con MONGO_DB; los defaults son:
#   activation-api        poc_activation
#   billing-service       poc_billing
#   provisioning-service  poc_provisioning
#   notification-service  poc_notifications
#   crm-analytics-service poc_crm_analytics
#   loyalty-service       poc_loyalty
# ---------------------------------------------------------------------------

KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=activation-poc-local
KAFKA_FROM_BEGINNING=true
LOG_LEVEL=info

# Desde el host conviene directConnection: el replica set anuncia "mongo:27017".
MONGO_URI=mongodb://localhost:27017/?directConnection=true

# Puerto HTTP del proceso: 3000 activation-api, 3004 crm-analytics, 3005 loyalty.
PORT=3000
ACTIVATION_API_PORT=3000
KAFKA_UI_PORT=8080
UI_ORIGIN=http://localhost:5173

# Vite las toma al iniciar el dev server (apps/demo-ui/.env o variables
# del proceso). Los defaults del código ya son estos valores.
VITE_API_URL=http://localhost:3000
VITE_INSIGHTS_URL=http://localhost:3004
VITE_KAFKA_UI_URL=http://localhost:8080
VITE_MAILHOG_URL=http://localhost:8025

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=activaciones@demo.test
MAIL_INTERVAL_MS=500

BILLING_DELAY_MS=700
PROVISIONING_DELAY_MS=1800
OUTBOX_POLL_MS=500
